# Vercel → Project → Settings → Environment Variables (Production + Preview)
#
# Option A (recommended): one URL from Railway / Aiven / etc.
# Enable PUBLIC TCP on the database, then use the public mysql URL.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/shop_inventory
#
# Option B: separate variables
# DB_HOST=containers-us-west-xxx.railway.app
# DB_PORT=3306
# DB_NAME=shop_inventory
# DB_USER=root
# DB_PASSWORD=your-password
#
# Railway MySQL first-time import (optional):
# MYSQL_INIT_DUMP_URL=https://raw.githubusercontent.com/numaaannn/inventory-management-system/main/deploy/shop_inventory.sql
#
# After setting variables: Redeploy on Vercel, then verify:
# https://YOUR-PROJECT.vercel.app/health.php
# https://YOUR-PROJECT.vercel.app/login.php

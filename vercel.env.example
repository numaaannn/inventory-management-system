# Add these in Vercel → Project → Settings → Environment Variables
# Use a remote MySQL (Railway, PlanetScale, Aiven, or your cPanel DB with remote access enabled).

DB_HOST=your-mysql-host.example.com
DB_NAME=shop_inventory
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Optional: after first deploy, import deploy/shop_inventory.sql into the remote database.
